16px;font-weight:650;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:14px;align-items:center}summary::-webkit-details-marker{display:none}summary::after{content:"＋";color:var(--pri);flex:none}details[open]>summary::after{content:"−"}details>div{padding:0 18px 18px}li{margin:0 0 9px}ul,ol{padding-left:24px;margin:8px 0}.step{display:flex;gap:12px;margin:12px 0}.number{flex:none;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:var(--pri);color:white;font-weight:700}.fields{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:16px 0}.field{min-width:0}.wide{grid-column:1/-1}label,legend{font-weight:650;font-size:16px;display:block;margin:0 0 6px}label small{font-weight:400}input,select,textarea{display:block;width:100%;padding:11px 12px;border:1px solid #8999a8;border-radius:9px;background:var(--card);color:var(--ink);min-height:46px;font-size:16px}textarea{min-height:130px;resize:vertical}input[type=checkbox],input[type=radio]{width:20px;min-height:20px;accent-color:var(--pri);flex:none}.check{display:flex;align-items:flex-start;gap:10px;padding:8px 0;font-weight:400}.check input{margin-top:3px}.hint{font-size:14px;color:var(--mut);margin:5px 0 0}.searchbar{display:flex;gap:8px}.searchbar input{min-width:0}.searchbar .btn{flex:none}.filters{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:18px;margin:14px 0}.resultcount{font-size:14px;color:var(--mut);margin:12px 0}.source{font-size:13px;line-height:1.5;margin-top:12px}.office-title{font-size:17px;text-transform:none;line-height:1.4}.contact-row{border-top:1px solid var(--bd);padding:10px 0;font-size:15px}.contact-row:last-child{padding-bottom:0}.contact-row a{margin-right:10px}.pager{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:20px 0}.progress{display:flex;gap:6px;list-style:none;padding:0;margin:18px 0}.progress li{flex:1;font-size:13px;padding:6px;border-top:4px solid var(--bd);color:var(--mut);margin:0}.progress .active{border-color:var(--pri);color:var(--pri);font-weight:700}fieldset{border:0;padding:0;margin:18px 0}.review{white-space:pre-wrap;font:16px/1.65 system-ui;overflow-wrap:anywhere}.form-alert{color:var(--warn);font-weight:650}.quiz-choice{width:100%;text-align:left;border:1px solid var(--bd);border-radius:10px;padding:12px;background:var(--bg);color:var(--ink);margin:6px 0;font-size:16px}.quiz-choice.correct{background:var(--ok2);border-color:var(--ok)}.quiz-choice.incorrect{background:var(--warn2);border-color:var(--warn)}footer{border-top:1px solid var(--bd);padding-top:20px;margin-top:32px;font-size:13px;color:var(--mut)}footer a{margin-right:12px}button:focus-visible,summary:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--pri);outline-offset:3px}h1:focus{outline:none}button:disabled{cursor:default;opacity:.45}.print-area{display:none}.error{border:2px solid var(--warn)}.countmark{font-size:32px;font-weight:750;color:var(--pri)}.inline-list{display:flex;gap:10px;flex-wrap:wrap}.nowrap{white-space:nowrap}
