.pathbar{display:flex;align-items:center;gap:6px 14px;flex-wrap:wrap;margin:0 0 16px}.backbtn{display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:8px 16px;border:1px solid var(--bd);border-radius:10px;background:var(--card);color:var(--ink);font-weight:650;font-size:15px}.backbtn:hover{border-color:var(--pri)}.crumbs{display:flex;flex-wrap:wrap;list-style:none;padding:0;margin:0;font-size:14px;color:var(--mut)}.crumbs li{margin:0}.crumbs li+li::before{content:"›";margin:0 7px}.crumbs a{color:var(--pri);text-decoration:none;font-weight:600}.crumbs [aria-current=page]{color:var(--ink);font-weight:650}.topnav a[aria-current=true]{background:var(--pri2)}.sos[hidden]{display:none}</style></head><body><a href="#contenido" class="skip">Saltar al contenido</a><header><button type="button" class="brand" onclick="go('inicio')" aria-label="Guía MASI inicio">🛡️ Guía MASI <span class="small">Perú</span></button><button type="button" class="exit" onclick="quickExit()" aria-label="Salir rápido y borrar el borrador de esta pestaña">Salir ✕</button></header><main id="app" aria-label="Guía de orientación"></main><noscript><div style="max-width:720px;margin:20px auto;padding:20px"><h1>Guía MASI Perú</h1><p>Para usar los formularios y el directorio, activa JavaScript. Si hay peligro inmediato llama al <a href="tel:105">105</a>. Para orientación en violencia llama al <a href="tel:100">100</a>.</p><p><a href="https://portal.mpfn.gob.pe/denuncias-en-linea/">Portal oficial de denuncias del Ministerio Público</a> · <a href="https://www.gob.pe/institucion/mpfn/colecciones/10807-directorio-fiscalias">Directorio de fiscalías</a></p><p>Este piloto orienta; no recibe denuncias.</p></div></noscript><a class="sos" href="#ayuda">Necesito ayuda ahora <small>Peligro inmediato: Policía 105</small></a><section id="print-area" class="print-area"></section><script>const CONTENT={"modalities":[{"id":"fisica","name":"Golpes y otras agresiones físicas","group":"Violencia","examples":"Golpear, empujar, quemar, lesionar o impedir cuidados que afectan la integridad física.","action":"Busca protección y atención de salud. Cuenta qué pasó, cuándo, dónde y quién lo hizo; no necesitas esperar a tener un certificado para denunciar.","legal":"Ley 30364, arts. 5 a 8 y 15; CP, arts. 121-B, 122 y 122-B, según los hechos. La relación familiar o el contexto de violencia de género importan para la calificación.","route":"violencia","keys":"golpe maltrato pareja familia hijos castigo"},{"id":"psicologica","name":"Humillaciones, amenazas y control","group":"Violencia","examples":"Insultos, aislamiento, vigilancia, intimidación o control de amistades, dinero, contraseñas y ubicación, también por mensajes.","action":"Describe las conductas, su frecuencia y cómo te afectan. Comunica amenazas recientes y antecedentes sin esperar a una pericia psicológica.","legal":"Ley 30364, art. 8; CP, arts. 122-B y 124-B, cuando concurren sus elementos. Una discusión aislada no permite afirmar automáticamente este delito.","route":"violencia","keys":"psicológica insultos coerción celular geolocalización celos control"},{"id":"sexual","name":"Violencia sexual","group":"Violencia","examples":"Actos sexuales impuestos mediante violencia, amenaza, coacción o aprovechamiento de una situación que impide consentir. Puede ocurrir dentro de una pareja o familia.","action":"Pide ayuda y atención de salud cuanto antes. La atención y la denuncia no deben esperar a reunir pruebas. Una niña, niño o adolescente también puede pedir ayuda directamente.","legal":"CP, arts. 170 a 175 y 177, según edad, circunstancias y modalidad. Ley 30364 cuando corresponde a su ámbito de protección.","route":"violencia","keys":"violación abuso inconsciencia pareja consentimiento"},{"id":"tocamientos","name":"Tocamientos y actos sexuales sin consentimiento","group":"Violencia","examples":"Tocar partes íntimas, obligar a tocar o realizar actos de connotación sexual sin consentimiento, incluidos hechos en transporte, colegio, trabajo u hogar.","action":"Comunica lugar, hora, descripción de la persona y presencia de testigos o cámaras. Si afecta a un menor, escucha sin interrogarlo repetidamente.","legal":"CP, arts. 176, 176-A y 177. La edad de la víctima y las circunstancias determinan el tipo aplicable.","route":"violencia","keys":"tocamiento transporte colegio actos libidinosos"},{"id":"feminicidio","name":"Ataques que ponen en peligro la vida","group":"Violencia","examples":"Amenazas de muerte, intento de matar, ataques con armas o agresiones graves en un contexto de violencia contra una mujer.","action":"Ante peligro actual llama al 105 o acude a un lugar seguro y a la autoridad más cercana. No esperes a llenar el formulario.","legal":"CP, art. 108-B y reglas de tentativa, si concurren sus elementos. El riesgo debe comunicarse aunque todavía no se conozca la calificación penal.","route":"violencia","keys":"feminicidio tentativa muerte arma estrangulamiento"},{"id":"economica","name":"Violencia económica o patrimonial","group":"Violencia","examples":"Retener documentos, destruir bienes, controlar ingresos o privar de recursos necesarios para someter a una persona en el ámbito protegido por la Ley 30364.","action":"Explica qué bienes o recursos están afectados y qué necesitas para estar a salvo. Busca orientación en Línea 100 o un CEM.","legal":"Ley 30364, art. 8. Es una forma de violencia; no equivale por sí sola a un delito autónomo. La autoridad evalúa si concurren daños, apropiación, coacción u otro delito y la vía de protección.","route":"proteccion","keys":"dinero documentos bienes sueldo patrimonio alimentos"},{"id":"acoso","name":"Persecución y acoso presencial o digital","group":"Digital","examples":"Vigilar, perseguir, buscar cercanía o contactar sin consentimiento de manera que afecte la vida cotidiana; puede hacerse mediante cuentas, llamadas o ubicación.","action":"Anota episodios y conserva los mensajes existentes de manera segura. No confrontes a la persona ni la sigas para obtener pruebas.","legal":"CP, art. 151-A, incorporado por D. Leg. 1410. La reiteración y el efecto sobre la vida cotidiana se evalúan según el supuesto legal.","route":"violencia","keys":"stalking ciberacoso seguimiento vigilancia llamadas"},{"id":"acoso-sexual","name":"Acoso sexual por mensajes o en persona","group":"Digital","examples":"Buscar contacto, vigilar o perseguir sin consentimiento con finalidad sexual, incluso a través de redes, juegos o aplicaciones.","action":"Registra usuarios, fechas y descripción de la conducta. También puedes activar la ruta del colegio o del trabajo cuando corresponda.","legal":"CP, art. 176-B; D. Leg. 1410. El canal digital no convierte por sí solo este hecho en un delito de la Ley 30096.","route":"violencia","keys":"mensajes sexuales hostigamiento insistencia redes"},{"id":"chantaje-sexual","name":"Amenazas para obtener actos o imágenes sexuales","group":"Digital","examples":"Amenazar con publicar una imagen o divulgar información para exigir una conducta sexual o más imágenes.","action":"No envíes más material ni negocies por tu cuenta. Busca apoyo, anota la exigencia y conserva los mensajes ya recibidos sin redistribuir contenido íntimo.","legal":"CP, art. 176-C. Si se amenaza mediante tecnologías con material elaborado o modificado digitalmente, se evalúa el art. 5-A de la Ley 30096, incorporado por D. Leg. 1625.","route":"mixta","keys":"sextorsión chantaje amenaza fotos videos sexuales"},{"id":"extorsion","name":"Amenazas para exigir dinero","group":"Digital","examples":"Exigir dinero bajo amenaza de difundir intimidad, hacer daño o atacar a familiares; también mediante cuentas y números desconocidos.","action":"Ante peligro actual llama al 105. Conserva número, usuario, mensajes y datos de pago ya disponibles; no investigues ni pagues siguiendo instrucciones del agresor.","legal":"CP, art. 200 y otras figuras que correspondan. La exigencia patrimonial debe diferenciarse del chantaje que busca una conducta sexual.","route":"penal","keys":"extorsión pago yape transferencia dinero sextorsión"},{"id":"intimos","name":"Difusión de imágenes íntimas sin autorización","group":"Digital","examples":"Publicar, reenviar, revelar, ceder o comercializar imágenes, videos o audios sexuales de una persona sin autorización.","action":"Anota enlace, cuenta y fecha. Reporta la publicación a la plataforma y acude a la autoridad. No reenvíes material íntimo para pedir ayuda.","legal":"CP, art. 154-B, modificado por D. Leg. 1625. El texto vigente incluye contenido real y elaborado o modificado digitalmente; ya no exige que se haya obtenido con anuencia.","route":"violencia","keys":"nudes difusión intimidad venganza imágenes porno publicación"},{"id":"deepfake","name":"Imágenes sexuales manipuladas con tecnología","group":"Digital","examples":"Difundir montajes o contenido sexual generado o modificado digitalmente atribuyéndolo a una persona, o usarlo para amenazarla.","action":"Describe qué se publicó o exigió y dónde apareció. No necesitas demostrar por tu cuenta cómo se creó el montaje.","legal":"CP, art. 154-B para la difusión sin autorización; Ley 30096, art. 5-A para la amenaza con material digitalmente elaborado o modificado destinada a obtener conducta sexual. No toda creación aislada configura automáticamente esos tipos.","route":"mixta","keys":"deepfake inteligencia artificial IA montaje falso rostro"},{"id":"grooming","name":"Contacto con menores con finalidad sexual","group":"Niñez","examples":"Contactar a una niña, niño o adolescente por redes, juegos u otros medios para solicitar material sexual o proponer actos sexuales, con las condiciones de edad y engaño previstas en la ley.","action":"No continúes la conversación haciéndote pasar por el menor. Conserva la cuenta o el dispositivo existente y pide intervención de la PNP o Fiscalía.","legal":"Ley 30096, art. 5, modificado por D. Leg. 1591, para el contacto tecnológico; CP, art. 183-B, según el supuesto. Para víctimas de 14 a menos de 18 años el art. 5 exige engaño.","route":"grooming","keys":"grooming juego videojuegos regalos secreto adulto contacto menor"},{"id":"masi","name":"Material de abuso sexual infantil MASI","group":"Niñez","examples":"Producir, poseer, distribuir o comercializar material sexual que involucra a menores de edad, según los elementos de la ley. Compartirlo para avisar también puede causar daño y generar responsabilidad.","action":"No lo busques, descargues, captures, solicites ni reenvíes. Si ya está en un dispositivo, deja de manipularlo y pide instrucciones a la autoridad; anota únicamente datos de ubicación y cuenta si es seguro.","legal":"CP, art. 129-M, cuya denominación legal es pornografía infantil; reubicado por Ley 31146. MASI es la expresión de protección utilizada por esta guía.","route":"trata","keys":"MASI abuso infantil pornografía infantil material menores"},{"id":"trata","name":"Captación y explotación de personas","group":"Niñez","examples":"Ofertas engañosas de trabajo, modelaje, viajes o relaciones usadas para captar y explotar a una persona; puede comenzar por internet.","action":"Ante peligro o retención llama al 105. Comunica ofertas, cuentas, lugares y amenazas que ya conozcas sin acudir a encuentros para comprobarlos.","legal":"CP, arts. 129-A y siguientes, según la conducta. La trata y la explotación tienen elementos propios; no toda oferta sospechosa acredita el delito.","route":"trata","keys":"trata explotación captación modelaje trabajo viajes"},{"id":"cuentas","name":"Ingreso a cuentas y fraude informático","group":"Digital","examples":"Acceder sin autorización a una cuenta o sistema, alterar datos o realizar operaciones fraudulentas mediante tecnologías.","action":"Desde un dispositivo seguro, protege el acceso y contacta a tu proveedor o entidad financiera por sus canales oficiales. Anota avisos de acceso y operaciones ya disponibles.","legal":"Ley 30096, arts. 2 y 8, según elementos y modificatorias. La Fiscalía especializada en Ciberdelincuencia o la penal competente evalúa el caso.","route":"ciber","keys":"hackeo contraseña phishing estafa fraude robo cuenta"},{"id":"suplantacion","name":"Suplantación de identidad en internet","group":"Digital","examples":"Usar la identidad de otra persona mediante tecnologías y ocasionarle un perjuicio, por ejemplo creando un perfil falso para obtener dinero o dañarla.","action":"Conserva la dirección del perfil y los mensajes existentes, reporta la cuenta y comunica el perjuicio. No proporciones claves a quien ofrezca recuperar la cuenta.","legal":"Ley 30096, art. 9, modificado por D. Leg. 1591. La existencia de un perfil parecido, sin los elementos del tipo, no determina por sí sola responsabilidad penal.","route":"ciber","keys":"identidad perfil falso impostor suplantación"},{"id":"datos","name":"Exposición o uso ilícito de datos personales","group":"Digital","examples":"Divulgar dirección, teléfono o información sensible para intimidar; adquirir o traficar ilícitamente datos; recopilar o usar datos sin la base legal correspondiente.","action":"Anota dónde aparecen los datos y comunica las amenazas. La ANPD atiende la vía de protección de datos; la PNP y Fiscalía evalúan los hechos con relevancia penal.","legal":"Ley 29733 y D.S. 016-2024-JUS. En materia penal se evalúan la Ley 30096, incluido art. 12-A incorporado por D. Leg. 1700 y modificado por D. Leg. 1741, y otros tipos. Doxxing no es una calificación penal automática.","route":"ciber","keys":"doxxing doxing filtración datos dirección teléfono base datos"},{"id":"escolar","name":"Violencia escolar y ciberbullying","group":"Niñez","examples":"Humillar, amenazar, excluir o difundir contenido para atacar a un estudiante, presencialmente o en grupos y redes vinculados a la comunidad educativa.","action":"Pide protección al colegio y registra el caso en SíseVe. Si hay violencia sexual, lesiones, amenazas u otro hecho delictivo, activa también la ruta policial o fiscal.","legal":"La atención educativa y la penal cumplen funciones diferentes. Ciberbullying describe una conducta; los hechos concretos determinan si existe un delito y cuál es su competencia.","route":"escolar","keys":"bullying colegio escuela docente estudiante clase"},{"id":"laboral","name":"Hostigamiento sexual en trabajo o estudios","group":"Violencia","examples":"Conductas sexuales o sexistas no deseadas que afectan a una persona en una relación laboral, educativa u otra relación prevista por la Ley 27942.","action":"Activa el canal de la institución y solicita medidas de protección. Si también hay un delito, puedes acudir a la PNP o Fiscalía sin esperar el resultado administrativo.","legal":"Ley 27942 y su reglamento; D. Leg. 1410. Hostigamiento sexual y acoso sexual penal no tienen exactamente los mismos elementos.","route":"laboral","keys":"hostigamiento jefe profesor universidad trabajo empleo"},{"id":"medidas","name":"Incumplimiento de medidas de protección","group":"Violencia","examples":"Acercarse pese a una prohibición, contactar por nuevas cuentas o realizar conductas expresamente prohibidas por una medida de protección.","action":"Si hay riesgo actual llama al 105. Comunica el incumplimiento y cualquier nueva agresión; lleva la resolución o sus datos si los tienes, sin retrasar la ayuda.","legal":"CP, art. 368, y normas de la Ley 30364. Un incumplimiento sin nueva agresión y un nuevo acto de violencia requieren diferenciar los tipos penales y las reglas locales de competencia.","route":"medidas","keys":"desobediencia protección orden alejamiento acercamiento"},{"id":"exhibiciones","name":"Exhibiciones o actos obscenos","group":"Violencia","examples":"Conductas obscenas en lugares públicos o exhibición y distribución de material a menores, según las modalidades legales.","action":"Describe lo observado sin reproducir material sexual. Si afecta a un menor, solicita protección y evita exponer su identidad en redes o grupos.","legal":"CP, art. 183. Debe distinguirse de tocamientos, acoso sexual y material de abuso sexual infantil; la competencia se verifica con las reglas de Trata y la distribución fiscal local.","route":"penal","keys":"exhibicionismo obsceno exposición calle"}],"sources":[{"id":"L1","name":"Ley 30364 y modificatorias","detail":"Sujetos protegidos, formas de violencia y presentación de denuncias. El texto consolidado incorpora la Ley 31715 sobre identificación y reserva.","url":"https://www3.congreso.gob.pe/Docs/DefensoriaMujer/files/normas-legales/ley_30364.pdf"},{"id":"L2","name":"RFN 3491 de 2019 MP FN","detail":"Competencia material, personal y territorial de las fiscalías especializadas de violencia; excepción del art. 183-B para Trata.","url":"https://busquedas.elperuano.pe/dispositivo/NL/1835751-2"},{"id":"L3","name":"Decreto Legislativo 1410","detail":"Acoso, acoso sexual y chantaje sexual; modifica la Ley 27942.","url":"https://busquedas.elperuano.pe/dispositivo/NL/1690482-3"},{"id":"L4","name":"Decreto Legislativo 1625","detail":"Texto actualizado del art. 154-B del CP y creación del art. 5-A de la Ley 30096.","url":"https://busquedas.elperuano.pe/dispositivo/NL/2313391-1"},{"id":"L5","name":"Decreto Legislativo 1591","detail":"Contacto tecnológico con menores con fines sexuales y suplantación de identidad.","url":"https://busquedas.elperuano.pe/dispositivo/NL/2243815-1"},{"id":"L6","name":"Ley 31146","detail":"Reubicación de trata y explotación; art. 129-M del Código Penal.","url":"https://busquedas.elperuano.pe/dispositivo/NL/1939453-1"},{"id":"L7","name":"Ley 30096 y modificatorias publicadas por el MP","detail":"Delitos informáticos; leer junto con las reformas posteriores citadas en esta guía.","url":"https://www.gob.pe/institucion/mpfn/informes-publicaciones/1678028-ley-"},{"id":"L8","name":"Decreto Legislativo 1700","detail":"Adquisición, posesión y tráfico ilícito de datos informáticos, art. 12-A de la Ley 30096.","url":"https://busquedas.elperuano.pe/dispositivo/NL/2480387-2"},{"id":"L9","name":"Decreto Legislativo 1741"